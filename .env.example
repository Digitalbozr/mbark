# Firebase Configuration
# الرجاء تعيين البيانات التالية من Firebase Console

# معرف المشروع (Project ID) - يمكن إيجاده من بريد الخدمة
# مثال: mbark-60c12
PROJECT_ID=mbark-60c12

# معرف قاعدة البيانات (Database URL)
# الصيغة: https://[PROJECT_ID].firebaseio.com
# مثال: https://mbark-60c12.firebaseio.com
FIREBASE_DATABASE_URL=https://mbark-60c12.firebaseio.com

# Option 1: استخدام ملف Service Account
# قم بتنزيل الملف من Firebase Console وضعه في جذر المشروع
# ثم أعد تسميته إلى serviceAccountKey.json
# (هذه الطريقة آمن للتطوير المحلي)

# Option 2: استخدام متغيرات البيئة
# قم بنسخ محتوى serviceAccountKey.json كاملاً إلى المتغير التالي
# (هذه الطريقة آمن للـ Production)
FIREBASE_SERVICE_ACCOUNT=

# منفذ التطبيق
PORT=3000

# ملاحظة أمنية:
# استخدم Option 1 في التطوير المحلي
# استخدم Option 2 في Production (متغيرات البيئة الآمنة)
